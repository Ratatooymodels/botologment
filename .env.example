# Обязательно: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Тексты для инфографики. Бесплатно: ключ Gemini из aistudio.google.com
# Без ключей бот берёт текст из подписи к фото
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Платная альтернатива (необязательно)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Необязательно и платно: стиль «AI-сцена» (fal.ai)
FAL_KEY=

# Настройки
CARD_WIDTH=1200          # 1200 -> 1200x1600, 900 -> 900x1200 (формат 3:4)
DAILY_FREE_LIMIT=3       # карточек на пользователя в день, 0 = без лимита
MAX_PARALLEL_JOBS=1
REMBG_MODEL=isnet-general-use
# FONT_BOLD=/path/to/Inter-Bold.ttf
# FONT_REGULAR=/path/to/Inter-Regular.ttf

# Лёгкий режим для бесплатного хостинга (без rembg на сервере)
# REMBG_BACKEND=fal        # нужен FAL_KEY
# WEBHOOK_URL=             # публичный https-адрес сервиса (на Render подставляется сам)
